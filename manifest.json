{
  "manifest_version": 3,
  "name": "Snapshot",
  "version": "0.5.2",
  "description": "Capture webpage elements or areas. Copy immediately, save to your library or download only when you choose.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "clipboardWrite",
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Snapshot - click to capture; right-click for library"
  },
  "options_page": "gallery.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      }
    },
    "open-gallery": {
      "description": "Open your screenshot library",
      "suggested_key": {
        "default": "Alt+Shift+L"
      }
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
